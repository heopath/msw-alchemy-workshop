@Component
script GiantMushroomAI extends Component

	-- Pattern A (script-driven SpriteRUID). No AIChase/AIWander on the model.
	property string StandRUID = "6f64634a61134b6eb6da027b642a959a"

	property string StompRUID = "16a02ec8b3094ed6bbea2595976a083a"

	property string SporeRUID = "1763c25f69df4a11a6e76cfcf6dbe374"

	property string DieRUID = "a4ecfa0cc1544a6087d176a45b8293a3"

	property string SporeModelId = "sporeshot"

	property string RegionName = "Henesys"

	@MinValue(0)
	property number StompInterval = 3.0

	@MinValue(0)
	property number StompIntervalPhase2 = 2.0

	@MinValue(0)
	property number SporeInterval = 5.0

	@MinValue(0)
	property number StompTelegraph = 0.5

	@MinValue(0)
	property number StompRecover = 0.4

	@MinValue(0)
	property number SporeDuration = 0.6

	-- number, not integer: an `integer` property produced LWA-4012 against the .model value.
	@MinValue(0)
	property number SporeCount = 3

	@MinValue(0)
	property number SporeSpreadDegrees = 15

	@MinValue(0)
	property number PhaseThreshold = 0.5

	@MinValue(0)
	property number SporeMuzzleForward = 0.9

	@MinValue(0)
	property number SporeMuzzleHeight = 0.7

	@HideFromInspector
	property string AIState = "WAIT"

	@HideFromInspector
	property number StateTimer = 0

	@HideFromInspector
	property string NextPattern = "STOMP"

	@HideFromInspector
	property boolean Phase2 = false

	@HideFromInspector
	property boolean DeathPlayed = false

	@HideFromInspector
	property integer SporeSeq = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Opens on the stomp pattern; patterns then alternate stomp -> spore -> stomp.
		self.NextPattern = "STOMP"
		self.Phase2 = false
		self.DeathPlayed = false
		self:EnterWait()

		local monster = self.Entity.Monster
		local maxHp = 0
		if isvalid(monster) then
			maxHp = monster.MaxHp
		end

		log("GiantMushroomAI ready on " .. self.Entity.Name .. ", MaxHp=" .. tostring(maxHp) .. ", region=" .. self.RegionName)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Drives the death check, the phase check, facing, and the pattern timer.
		local monster = self.Entity.Monster

		if isvalid(monster) and monster.IsDead then
			if self.DeathPlayed == false then
				self.DeathPlayed = true
				self.AIState = "DEAD"
				self:SetClip(self.DieRUID)
				self:SetTint(Color(1, 1, 1, 1))
				self:AnnounceDefeat()
			end
			return
		end

		self:CheckPhase()

		if self.AIState == "WAIT" then
			self:FaceNearestPlayer()
		end

		self.StateTimer = self.StateTimer - delta
		if self.StateTimer > 0 then
			return
		end

		if self.AIState == "WAIT" then
			if self.NextPattern == "STOMP" then
				self:BeginStomp()
			else
				self:BeginSpore()
			end
		elseif self.AIState == "TELEGRAPH" then
			self:ExecuteStomp()
		elseif self.AIState == "STOMP" then
			self.NextPattern = "SPORE"
			self:EnterWait()
		elseif self.AIState == "SPORE" then
			self.NextPattern = "STOMP"
			self:EnterWait()
		end
	end

	@ExecSpace("ServerOnly")
	method void CheckPhase()
		-- Below PhaseThreshold of MaxHp the stomp cycle shortens. One-way switch.
		if self.Phase2 then
			return
		end

		local monster = self.Entity.Monster
		if not isvalid(monster) then
			return
		end

		if monster.MaxHp <= 0 then
			return
		end

		if monster.Hp > monster.MaxHp * self.PhaseThreshold then
			return
		end

		self.Phase2 = true
		log("GiantMushroom entered phase 2 at Hp=" .. tostring(monster.Hp) .. ", stomp cycle " .. tostring(self.StompInterval) .. "s -> " .. tostring(self.StompIntervalPhase2) .. "s")
	end

	@ExecSpace("ServerOnly")
	method void EnterWait()
		-- Idles until the next pattern is due. The wait length belongs to the upcoming pattern.
		self.AIState = "WAIT"
		self:SetClip(self.StandRUID)
		self:SetTint(Color(1, 1, 1, 1))

		if self.NextPattern == "STOMP" then
			self.StateTimer = self:CurrentStompInterval()
		else
			self.StateTimer = self.SporeInterval
		end
	end

	@ExecSpace("ServerOnly")
	method number CurrentStompInterval()
		-- Phase 2 shortens the stomp cycle.
		if self.Phase2 then
			return self.StompIntervalPhase2
		end

		return self.StompInterval
	end

	@ExecSpace("ServerOnly")
	method void BeginStomp()
		-- Telegraph window: the boss tints red and holds still so the player can read the tell.
		self.AIState = "TELEGRAPH"
		self.StateTimer = self.StompTelegraph
		self:SetClip(self.StompRUID)
		self:SetTint(Color(1, 0.45, 0.45, 1))
		log("GiantMushroom telegraphing stomp for " .. tostring(self.StompTelegraph) .. "s")
	end

	@ExecSpace("ServerOnly")
	method void ExecuteStomp()
		-- Landing frame: resolve the AoE, then hold a short recovery before the next pattern.
		self.AIState = "STOMP"
		self.StateTimer = self.StompRecover
		self:SetTint(Color(1, 1, 1, 1))

		local attack = self.Entity.GiantMushroomAttack
		if isvalid(attack) then
			attack:DoStomp()
		end

		local transform = self.Entity.TransformComponent
		if isvalid(transform) then
			local worldPosition = transform.WorldPosition
			self:PlayStompEffect(worldPosition.x, worldPosition.y, worldPosition.z)
		end
	end

	@ExecSpace("ServerOnly")
	method void BeginSpore()
		-- Fires the spore fan on entry, then holds the cast pose for SporeDuration.
		self.AIState = "SPORE"
		self.StateTimer = self.SporeDuration
		self:SetClip(self.SporeRUID)
		self:FireSpores()
	end

	@ExecSpace("ServerOnly")
	method void FireSpores()
		-- Spawns SporeCount projectiles in a forward fan centred on the facing direction.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return
		end

		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return
		end

		local worldPosition = transform.WorldPosition
		local facing = self:FacingSign()
		local spread = math.rad(self.SporeSpreadDegrees)
		local half = (self.SporeCount - 1) / 2
		local spawned = 0

		for i = 0, self.SporeCount - 1 do
			local angle = (i - half) * spread
			local dirX = math.cos(angle) * facing
			local dirY = math.sin(angle)

			self.SporeSeq = self.SporeSeq + 1
			local name = "SporeShot_" .. tostring(self.SporeSeq)
			local spawnPosition = Vector3(worldPosition.x + dirX * self.SporeMuzzleForward, worldPosition.y + self.SporeMuzzleHeight, worldPosition.z)

			local shotEntity = _SpawnService:SpawnByModelId(self.SporeModelId, name, spawnPosition, map)
			if shotEntity == nil then
				log_error("GiantMushroomAI: SpawnByModelId('" .. self.SporeModelId .. "') returned nil")
				return
			end

			local shot = shotEntity.SporeShot
			if isvalid(shot) then
				shot:Fire(dirX, dirY)
				spawned = spawned + 1
			end
		end

		log("GiantMushroom fired " .. tostring(spawned) .. " spores, facing=" .. tostring(facing))
	end

	@ExecSpace("ServerOnly")
	method number FacingSign()
		-- Mob sprites are authored facing left, so Scale.x is inverted to face right.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return 1
		end

		if transform.Scale.x > 0 then
			return -1
		end

		return 1
	end

	@ExecSpace("ServerOnly")
	method void FaceNearestPlayer()
		-- Turns toward the closest player. Only called while waiting, never mid-telegraph.
		local target = self:FindNearestPlayer()
		if not isvalid(target) then
			return
		end

		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return
		end

		local face = 1
		if target.TransformComponent.WorldPosition.x < transform.WorldPosition.x then
			face = -1
		end

		local scale = transform.Scale
		transform.Scale = Vector3(math.abs(scale.x) * -face, scale.y, scale.z)
	end

	@ExecSpace("ServerOnly")
	method Entity FindNearestPlayer()
		-- Canonical "players on this map" lookup; returns nil when the map is empty.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return nil
		end

		local mapComponent = map.MapComponent
		if not isvalid(mapComponent) then
			return nil
		end

		local users = _UserService:GetUsersByMapComponent(mapComponent)
		if users == nil then
			return nil
		end

		local myPosition = self.Entity.TransformComponent.WorldPosition
		local nearest = nil
		local nearestDistance = 0

		for _, user in pairs(users) do
			if isvalid(user) then
				local userPosition = user.TransformComponent.WorldPosition
				local dx = userPosition.x - myPosition.x
				local dy = userPosition.y - myPosition.y
				local distance = dx * dx + dy * dy

				if nearest == nil or distance < nearestDistance then
					nearest = user
					nearestDistance = distance
				end
			end
		end

		return nearest
	end

	@ExecSpace("ServerOnly")
	method void AnnounceDefeat()
		-- Reward signal for T3. The map entity carries it so a Logic can subscribe by path.
		local defeated = BossDefeatedEvent()
		defeated.RegionName = self.RegionName

		local map = self.Entity.CurrentMap
		if isvalid(map) then
			map:SendEvent(defeated)
		end

		-- T3: the run-state owner grants this region's ability and marks the region cleared.
		_AbilityLogic:ReportBossDefeated(self.RegionName)

		log("BossDefeatedEvent sent: region=" .. self.RegionName)
	end

	@ExecSpace("ServerOnly")
	method void SetClip(string ruid)
		-- Pattern A drives the visible clip by assigning SpriteRUID directly.
		if ruid == "" then
			return
		end

		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.SpriteRUID = ruid
		end
	end

	@ExecSpace("ServerOnly")
	method void SetTint(Color tint)
		-- Telegraph feedback. Color is @Sync so clients see the tell too.
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.Color = tint
		end
	end

	@ExecSpace("Client")
	method void PlayStompEffect(number px, number py, number pz)
		-- Dust burst on the landing frame; particles are a client-side presentation concern.
		local map = self.Entity.CurrentMap
		if map == nil then
			return
		end

		_ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, map, Vector3(px, py, pz), 0, Vector3(1.5, 1.5, 1))
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- Observation only; script.Monster owns the HP subtraction and the death call.
		local monster = self.Entity.Monster
		if not isvalid(monster) then
			return
		end

		log("GiantMushroom took " .. tostring(event.TotalDamage) .. " damage, Hp=" .. tostring(monster.Hp) .. "/" .. tostring(monster.MaxHp))
	end

end
