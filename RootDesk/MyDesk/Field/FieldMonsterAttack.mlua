@Component
script FieldMonsterAttack extends AttackComponent

	-- Shared contact-damage component for the Henesys field mobs. The three mobs differ
	-- only by the values stored on their .model, not by having three copies of this script.
	-- Declared as number (System.Double) so the .model value binds; CalcDamage floors it.
	@MinValue(0)
	property number ContactDamage = 5

	-- 0.03s matches script.MonsterAttack, the contact-damage implementation already proven in
	-- this project. At the previous 0.3s the player travelled 1.4 * 0.3 = 0.42 units between
	-- samples — wider than the snail's 0.40 hit box, so small mobs were stepped straight through.
	@MinValue(0)
	property number ContactInterval = 0.03

	-- Diagnostics: one summary line per this many seconds, so the log stays readable at 33Hz.
	@MinValue(0)
	property number LogInterval = 1.0

	@HideFromInspector
	property integer TickCount = 0

	@HideFromInspector
	property number LogTimer = 0

	property Vector2 ContactBoxSize = Vector2(0.6, 0.5)

	property Vector2 ContactBoxOffset = Vector2(0, 0.25)

	@HideFromInspector
	property any ContactShape = nil

	@HideFromInspector
	property integer ContactTimerId = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Builds the reusable contact box and starts the damage tick.
		self.ContactShape = BoxShape(Vector2.zero, self.ContactBoxSize, 0)

		self.ContactTimerId = _TimerService:SetTimerRepeat(function()
			self:ContactTick()
		end, self.ContactInterval)

		-- Log 1 of 4: proves the timer was actually armed on this entity.
		log("FieldMonsterAttack ready on " .. self.Entity.Name
			.. ", damage=" .. tostring(math.floor(self.ContactDamage))
			.. ", box=(" .. tostring(self.ContactBoxSize.x) .. ", " .. tostring(self.ContactBoxSize.y) .. ")"
			.. ", interval=" .. tostring(self.ContactInterval))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Releases the contact tick timer.
		if self.ContactTimerId ~= 0 then
			_TimerService:ClearTimer(self.ContactTimerId)
			self.ContactTimerId = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void ContactTick()
		-- Touch damage only; field mobs have no active attack pattern.
		local monster = self.Entity.Monster
		if isvalid(monster) and monster.IsDead then
			return
		end

		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return
		end

		local worldPosition = transform.WorldPosition
		self.ContactShape.Size = self.ContactBoxSize
		self.ContactShape.Angle = 0
		self.ContactShape.Position = Vector2(worldPosition.x + self.ContactBoxOffset.x, worldPosition.y + self.ContactBoxOffset.y)

		-- Attack (not AttackFast) so the resolved target list can be counted. AttackFast returns
		-- nothing, which makes "ran but found nobody" indistinguishable from "never ran".
		local hits = self:Attack(self.ContactShape, "contact", CollisionGroups.Player)

		local hitCount = 0
		if hits ~= nil then
			for _, hit in pairs(hits) do
				hitCount = hitCount + 1
			end
		end

		self.TickCount = self.TickCount + 1

		if hitCount > 0 then
			-- Log 3 of 4: the box actually resolved onto somebody.
			log(self.Entity.Name .. " contact HIT " .. tostring(hitCount) .. " target(s) for " .. tostring(math.floor(self.ContactDamage)))
			return
		end

		self.LogTimer = self.LogTimer + self.ContactInterval
		if self.LogTimer >= self.LogInterval then
			self.LogTimer = 0
			-- Log 2 of 4: the timer is running but the box is not reaching anyone.
			log(self.Entity.Name .. " contact tick #" .. tostring(self.TickCount)
				.. " at x=" .. tostring(worldPosition.x) .. " y=" .. tostring(worldPosition.y)
				.. ", candidates=0")
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- Parent declares no @ExecSpace, so this override must not add one either (LEA-3014).
		return math.floor(self.ContactDamage)
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- Only players take contact damage.
		if isvalid(defender.PlayerComponent) == false then
			-- Log 4 of 4: something was in the box but got filtered out here.
			log(self.Entity.Name .. " contact rejected non-player: " .. defender.Name)
			return false
		end

		return __base:IsAttackTarget(defender, attackInfo)
	end

end
